{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "fetchChangeLogs": "pr",
  "prBodyNotes": ["Read the release notes above for breaking changes before you merge."],
  "packageRules": [
    {
      "matchPackageNames": ["homeassistant/home-assistant"],
      "sourceUrl": "https://github.com/home-assistant/core"
    },
    {
      "matchPackageNames": ["ghcr.io/music-assistant/server"],
      "sourceUrl": "https://github.com/music-assistant/server"
    },
    {
      "matchPackageNames": ["pihole/pihole"],
      "sourceUrl": "https://github.com/pi-hole/docker-pi-hole"
    },
    {
      "matchPackageNames": ["quay.io/prometheus/node-exporter"],
      "sourceUrl": "https://github.com/prometheus/node_exporter"
    },
    {
      "matchPackageNames": ["prometheuscommunity/smartctl-exporter"],
      "sourceUrl": "https://github.com/prometheus-community/smartctl_exporter"
    },
    {
      "matchPackageNames": ["kubernetesui/dashboard"],
      "sourceUrl": "https://github.com/kubernetes/dashboard"
    },
    {
      "matchPackageNames": ["kubernetesui/metrics-scraper"],
      "sourceUrl": "https://github.com/kubernetes-sigs/dashboard-metrics-scraper"
    },
    {
      "matchPackageNames": ["postgres"],
      "sourceUrl": "https://github.com/postgres/postgres",
      "changelogUrl": "https://www.postgresql.org/docs/release/"
    },
    {
      "matchPackageNames": ["valkey/valkey"],
      "sourceUrl": "https://github.com/valkey-io/valkey"
    },
    {
      "matchPackageNames": ["eclipse-mosquitto"],
      "sourceUrl": "https://github.com/eclipse-mosquitto/mosquitto"
    },
    {
      "matchPackageNames": ["registry"],
      "sourceUrl": "https://github.com/distribution/distribution"
    },
    {
      "matchPackageNames": ["dpage/pgadmin4"],
      "sourceUrl": "https://github.com/pgadmin-org/pgadmin4"
    },
    {
      "matchPackageNames": ["prom/prometheus"],
      "sourceUrl": "https://github.com/prometheus/prometheus"
    },
    {
      "matchPackageNames": ["prom/blackbox-exporter"],
      "sourceUrl": "https://github.com/prometheus/blackbox_exporter"
    },
    {
      "matchPackageNames": ["victoriametrics/victoria-logs"],
      "sourceUrl": "https://github.com/VictoriaMetrics/VictoriaLogs"
    },
    {
      "matchPackageNames": ["fluent/fluent-bit"],
      "sourceUrl": "https://github.com/fluent/fluent-bit"
    },
    {
      "matchPackageNames": ["jellyfin/jellyfin"],
      "sourceUrl": "https://github.com/jellyfin/jellyfin"
    },
    {
      "matchPackageNames": ["grafana/grafana"],
      "sourceUrl": "https://github.com/grafana/grafana"
    },
    {
      "matchPackageNames": ["n8nio/n8n"],
      "sourceUrl": "https://github.com/n8n-io/n8n"
    },
    {
      "matchPackageNames": ["miniflux/miniflux"],
      "sourceUrl": "https://github.com/miniflux/v2"
    },
    {
      "matchPackageNames": ["ghcr.io/gramps-project/grampsweb"],
      "sourceUrl": "https://github.com/gramps-project/gramps-web"
    },
    {
      "matchPackageNames": ["ghcr.io/cooklang/cookcli"],
      "sourceUrl": "https://github.com/cooklang/cookcli"
    },
    {
      "matchPackageNames": ["renovate/renovate"],
      "sourceUrl": "https://github.com/renovatebot/renovate"
    },
    {
      "matchPackageNames": ["registry.home.arpa/go-tube"],
      "sourceUrl": "https://gitlab.com/CampFireMan/go-tube"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^terraform/go_tube\\.tf$/"],
      "matchStrings": [
        "go_tube_tag\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "go-tube",
      "packageNameTemplate": "registry.home.arpa/go-tube",
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/roles/zimaboard/vars/main\\.yml$/"],
      "matchStrings": [
        "ha_version:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "home-assistant",
      "packageNameTemplate": "homeassistant/home-assistant",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/roles/zimaboard/vars/main\\.yml$/"],
      "matchStrings": [
        "music_assistant_version:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "music-assistant",
      "packageNameTemplate": "ghcr.io/music-assistant/server",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/roles/zimaboard/vars/main\\.yml$/"],
      "matchStrings": [
        "pihole_version:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "pihole",
      "packageNameTemplate": "pihole/pihole",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/roles/common-infra/vars/main\\.yml$/"],
      "matchStrings": [
        "node_exporter_version:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "node-exporter",
      "packageNameTemplate": "quay.io/prometheus/node-exporter",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible/roles/common-infra/vars/main\\.yml$/",
        "/^ansible/roles/zimaboard/vars/main\\.yml$/"
      ],
      "matchStrings": [
        "smartctl_exporter_version:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "smartctl-exporter",
      "packageNameTemplate": "prometheuscommunity/smartctl-exporter",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/roles/services/tasks/kubernetes-dashboard\\.yml$/"],
      "matchStrings": [
        "image:\\s*kubernetesui/dashboard:(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "kubernetes-dashboard",
      "packageNameTemplate": "kubernetesui/dashboard",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/roles/services/tasks/kubernetes-dashboard\\.yml$/"],
      "matchStrings": [
        "image:\\s*kubernetesui/metrics-scraper:(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "dashboard-metrics-scraper",
      "packageNameTemplate": "kubernetesui/metrics-scraper",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
